{
  "cleanUrls": true,
  "outputDirectory": "dist",
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build", "config": { "outputDirectory": "dist" } },
    { "src": "api/index.ts", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.ts" },
    { "src": "/enterprise-portal/assets/(.*)", "dest": "/enterprise-portal/assets/$1" },
    { "src": "/enterprise-portal/(.*)", "dest": "/enterprise-portal/$1" },
    { "src": "/public-site/assets/(.*)", "dest": "/public-site/assets/$1" },
    { "src": "/public-site/(.*)", "dest": "/public-site/$1" },
    { "src": "/assets/(.*)", "dest": "/public-site/assets/$1" },
    { "src": "/SouthSudanFlag.svg", "dest": "/SouthSudanFlag.svg" },
    { "src": "/(.*)", "dest": "/public-site/$1" }
  ]
}

{
  "cleanUrls": true,
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/", "destination": "/public-site/index.html" },
    { "source": "/index.html", "destination": "/public-site/index.html" },
    { "source": "/enterprise-portal/:path*", "destination": "/enterprise-portal/:path*" },
    { "source": "/public-site/:path*", "destination": "/public-site/:path*" },
    { "source": "/SouthSudanFlag.svg", "destination": "/SouthSudanFlag.svg" },
    { "source": "/assets/:path*", "destination": "/public-site/assets/:path*" },
    { "source": "/:path*", "destination": "/public-site/:path*" }
  ]
}

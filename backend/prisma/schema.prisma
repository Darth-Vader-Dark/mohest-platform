// MoHEST Enterprise Portal — core schema
// Dynamic RBAC: no roles or permissions are hardcoded in application code.
// Everything is data — new roles, permissions, and departments can be added
// without a deployment.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  firstName     String
  lastName      String
  isActive      Boolean  @default(true)
  mustResetPassword Boolean @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])

  employee      Employee?

  roles         UserRole[]
  sessions      Session[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  notifications Notification[]
  createdBy     String?

  @@index([departmentId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) // seed roles (e.g. ICT Administrator) that cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  // e.g. "users.create", "employees.transfer", "id_cards.print"
  key         String   @unique
  module      String   // e.g. "ICT", "HR", "HR_ID_CARDS"
  description String?
  createdAt   DateTime @default(now())

  roles       RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Organisation
// ---------------------------------------------------------------------------

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique // e.g. "ICT", "HR", "HES"
  description String?
  parentId    String?
  parent      Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children    Department[] @relation("DeptHierarchy")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  employees   Employee[]

  @@map("departments")
}

// ---------------------------------------------------------------------------
// HR
// ---------------------------------------------------------------------------

model Employee {
  id             String   @id @default(uuid())
  employeeNumber String   @unique
  userId         String?  @unique
  user           User?    @relation(fields: [userId], references: [id])

  firstName      String
  lastName       String
  dateOfBirth    DateTime?
  gender         String?
  nationalId     String?
  phone          String?
  personalEmail  String?
  photoUrl       String?

  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id])
  position       String
  employmentType String   // Permanent, Contract, Probation
  hireDate       DateTime
  status         String   @default("Active") // Active, On Leave, Suspended, Terminated

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  qualifications      Qualification[]
  workExperience       WorkExperience[]
  departmentTransfers  DepartmentTransfer[]
  promotions           Promotion[]
  documents             EmployeeDocument[]
  idCards               IdCard[]

  @@index([departmentId])
  @@map("employees")
}

model Qualification {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  level       String   // e.g. Bachelor's, Master's, PhD
  fieldOfStudy String
  institution String
  yearAwarded Int
  certificateUrl String?

  @@index([employeeId])
  @@map("qualifications")
}

model WorkExperience {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employer    String
  title       String
  startDate   DateTime
  endDate     DateTime?
  description String?

  @@index([employeeId])
  @@map("work_experience")
}

model DepartmentTransfer {
  id             String   @id @default(uuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fromDepartment String
  toDepartment   String
  effectiveDate  DateTime
  reason         String?
  approvedBy     String?
  createdAt      DateTime @default(now())

  @@index([employeeId])
  @@map("department_transfers")
}

model Promotion {
  id            String   @id @default(uuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fromPosition  String
  toPosition    String
  effectiveDate DateTime
  approvedBy    String?
  createdAt     DateTime @default(now())

  @@index([employeeId])
  @@map("promotions")
}

model EmployeeDocument {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title      String
  category   String   // Appointment Letter, Contract, Certificate, etc.
  fileUrl    String
  uploadedAt DateTime @default(now())

  @@index([employeeId])
  @@map("employee_documents")
}

model IdCard {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  templateId  String?
  cardNumber  String   @unique
  issueDate   DateTime
  expiryDate  DateTime
  status      String   @default("Active") // Active, Reissued, Revoked, Expired
  qrPayload   String?
  createdAt   DateTime @default(now())

  @@index([employeeId])
  @@map("id_cards")
}

// ---------------------------------------------------------------------------
// Shared platform services
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // e.g. "user.create", "role.permission.update"
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Public site content (managed via Supabase, read by the public website)
// ---------------------------------------------------------------------------

model Institution {
  id          String   @id @default(uuid())
  name        String
  location    String
  state       String
  category    String   // "university" | "institute" | "community_college"
  type        String?  // "Public" | "Private" (for universities)
  established Int?
  status      String   @default("Accredited") // "Accredited" | "Under review" | "Provisional"
  website     String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([state])
  @@map("institutions")
}

model Scholarship {
  id              String   @id @default(uuid())
  title           String
  description     String?
  fields          String   // e.g. "STEM fields"
  level           String?  // "Undergraduate" | "Postgraduate" | "All levels"
  country         String
  status          String   @default("Open") // "Open" | "Opens quarterly" | "Annual cycle" | "Closed"
  applicationMode String   @default("none") // "link" | "pdf" | "none"
  link            String?  // external application site when applicationMode is "link"
  pdfUrl          String?  // downloadable application form when applicationMode is "pdf"
  deadline        DateTime?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("scholarships")
}

model NewsArticle {
  id          String   @id @default(uuid())
  title       String
  excerpt     String?
  publishedAt DateTime @default(now())
  isLead      Boolean  @default(false)
  thumbStyle  String?  // "gold" | null (green default)
  link        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publishedAt])
  @@map("news_articles")
}

model Leader {
  id          String   @id @default(uuid())
  name        String
  title       String
  directorate String?
  bio         String?
  photoUrl    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("leaders")
}

model PublicDownload {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String   @default("form") // "form" | "guideline" | "policy" | "statement" | "other"
  fileUrl     String
  fileSize    Int?
  fileLabel   String   @default("PDF")
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@map("public_downloads")
}

model GalleryItem {
  id          String   @id @default(uuid())
  title       String
  imageUrl    String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("gallery_items")
}


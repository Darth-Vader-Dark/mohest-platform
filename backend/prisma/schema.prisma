generator client {
  provider      = "prisma-client-js"
  output        = "../../node_modules/.prisma/client"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  passwordHash      String
  firstName         String
  lastName          String
  isActive          Boolean        @default(true)
  mustResetPassword Boolean        @default(false)
  lastLoginAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  departmentId      String?
  createdBy         String?
  auditLogs         AuditLog[]
  employee          Employee?
  notifications     Notification[]
  refreshTokens     RefreshToken[]
  sessions          Session[]
  roles             UserRole[]
  department        Department?    @relation(fields: [departmentId], references: [id])

  @@index([departmentId])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  module      String
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Department {
  id          String       @id @default(uuid())
  name        String       @unique
  code        String       @unique
  description String?
  parentId    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  parent      Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children    Department[] @relation("DeptHierarchy")
  employees   Employee[]
  users       User[]

  @@map("departments")
}

model Employee {
  id                  String               @id @default(uuid())
  employeeNumber      String               @unique
  userId              String?              @unique
  firstName           String
  lastName            String
  dateOfBirth         DateTime?
  gender              String?
  nationalId          String?
  phone               String?
  personalEmail       String?
  photoUrl            String?
  departmentId        String
  position            String
  employmentType      String
  hireDate            DateTime
  status              String               @default("Active")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  departmentTransfers DepartmentTransfer[]
  documents           EmployeeDocument[]
  department          Department           @relation(fields: [departmentId], references: [id])
  user                User?                @relation(fields: [userId], references: [id])
  idCards             IdCard[]
  promotions          Promotion[]
  qualifications      Qualification[]
  workExperience      WorkExperience[]

  @@index([departmentId])
  @@map("employees")
}

model Qualification {
  id             String   @id @default(uuid())
  employeeId     String
  level          String
  fieldOfStudy   String
  institution    String
  yearAwarded    Int
  certificateUrl String?
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("qualifications")
}

model WorkExperience {
  id          String    @id @default(uuid())
  employeeId  String
  employer    String
  title       String
  startDate   DateTime
  endDate     DateTime?
  description String?
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("work_experience")
}

model DepartmentTransfer {
  id             String   @id @default(uuid())
  employeeId     String
  fromDepartment String
  toDepartment   String
  effectiveDate  DateTime
  reason         String?
  approvedBy     String?
  createdAt      DateTime @default(now())
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("department_transfers")
}

model Promotion {
  id            String   @id @default(uuid())
  employeeId    String
  fromPosition  String
  toPosition    String
  effectiveDate DateTime
  approvedBy    String?
  createdAt     DateTime @default(now())
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("promotions")
}

model EmployeeDocument {
  id         String   @id @default(uuid())
  employeeId String
  title      String
  category   String
  fileUrl    String
  uploadedAt DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_documents")
}

model IdCard {
  id         String   @id @default(uuid())
  employeeId String
  templateId String?
  cardNumber String   @unique
  issueDate  DateTime
  expiryDate DateTime
  status     String   @default("Active")
  qrPayload  String?
  createdAt  DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("id_cards")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model Institution {
  id          String   @id @default(uuid())
  name        String
  location    String
  state       String
  category    String
  type        String?
  established Int?
  status      String   @default("Accredited")
  website     String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([state])
  @@map("institutions")
}

model Scholarship {
  id              String    @id @default(uuid())
  title           String
  description     String?
  fields          String
  level           String?
  country         String
  status          String    @default("Open")
  link            String?
  deadline        DateTime?
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  applicationMode String    @default("none")
  pdfUrl          String?

  @@map("scholarships")
}

model NewsArticle {
  id             String   @id @default(uuid())
  title          String
  excerpt        String?
  body           String?
  coverImageUrl  String?
  publishedAt    DateTime @default(now())
  isLead         Boolean  @default(false)
  thumbStyle     String?
  link           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([publishedAt])
  @@map("news_articles")
}

model Leader {
  id          String   @id @default(uuid())
  name        String
  title       String
  directorate String?
  bio         String?
  photoUrl    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("leaders")
}

model PublicDownload {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String   @default("form")
  fileUrl     String
  fileSize    Int?
  fileLabel   String   @default("PDF")
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@map("public_downloads")
}

model GalleryItem {
  id          String   @id @default(uuid())
  title       String
  imageUrl    String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("gallery_items")
}

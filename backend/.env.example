# Copy this file to .env and fill in real values before running the API.

# Postgres connection strings used by Prisma
# DATABASE_URL → used at runtime (transaction pooler in production; direct URL works for local dev)
# DIRECT_URL   → used for migrations (always use direct connection, port 5432)
DATABASE_URL="postgresql://mohest:mohest_dev_password@localhost:5432/mohest?schema=public"
DIRECT_URL="postgresql://mohest:mohest_dev_password@localhost:5432/mohest?schema=public"

# Redis (sessions, rate limiting, caching)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Argon2 (tune per deployment hardware — these are reasonable defaults)
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

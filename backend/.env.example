# Copy this file to .env and fill in real values before running the API.

# Postgres connection strings used by Prisma
# DATABASE_URL → pooled connection (port 6543)
# DIRECT_URL   → direct connection for migrations (port 5432)
DATABASE_URL="postgresql://postgres.qixrbxgkfbclvbsylxfl:[YOUR-DATABASE-PASSWORD]@aws-0-eu-north-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.qixrbxgkfbclvbsylxfl:[YOUR-DATABASE-PASSWORD]@aws-0-eu-north-1.pooler.supabase.com:5432/postgres"

# Supabase API and Auth credentials
SUPABASE_URL=https://qixrbxgkfbclvbsylxfl.supabase.co
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_SECRET_KEY="your-supabase-secret-key"
SUPABASE_JWKS_URL=https://qixrbxgkfbclvbsylxfl.supabase.co/auth/v1/.well-known/jwks.json

NEXT_PUBLIC_SUPABASE_URL=https://qixrbxgkfbclvbsylxfl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Redis (sessions, rate limiting, caching)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Argon2 (tune per deployment hardware — these are reasonable defaults)
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
